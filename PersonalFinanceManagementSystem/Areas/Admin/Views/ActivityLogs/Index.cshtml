@model AdminActivityListViewModel
@{
    var q = Model.Query;
    string FilterUrl() =>
        $"/Admin/ActivityLogs?user={Model.UserId}&action={Uri.EscapeDataString(Model.Action)}&sort={q.Sort}&dir={q.Dir}&size={q.Size}";
}

<div class="card-fin">
    <div class="card-head flex-wrap gap-2">
        <div>
            <h2 class="card-title">Activity Logs</h2>
            <div class="card-sub">Important user and system events, newest first</div>
        </div>
        <form asp-action="Clear" method="post" class="m-0"
              onsubmit="return confirm('Clear every activity log entry? This cannot be undone.');">
            <button type="submit" class="btn btn-soft"><svg class="ico-sm"><use href="#i-trash"/></svg> Clear all</button>
        </form>
    </div>

    <div class="card-body-fin">
        <div class="list-toolbar list-toolbar-flush">
            <partial name="_ListToolbar" model="q" />
        </div>

        <form method="get" class="log-filters">
            @foreach (var kv in Context.Request.Query.Where(kv => !new[] { "user", "action", "page" }.Contains(kv.Key, StringComparer.OrdinalIgnoreCase)))
            {
                <input type="hidden" name="@kv.Key" value="@kv.Value" />
            }
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <label class="small text-muted mb-0">Account</label>
                <select name="user" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                    <option value="0" selected="@(Model.UserId == 0)">Everyone</option>
                    @foreach (var (id, name) in Model.Users)
                    {
                        <option value="@id" selected="@(Model.UserId == id)">@name</option>
                    }
                </select>
                <label class="small text-muted mb-0 ms-2">Event</label>
                <select name="action" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                    <option value="all" selected="@(Model.Action == "all")">All events</option>
                    @foreach (var a in Model.Actions)
                    {
                        <option value="@a" selected="@(Model.Action == a)">@a</option>
                    }
                </select>
                <noscript><button type="submit" class="btn btn-soft btn-sm">Apply</button></noscript>
            </div>
        </form>

        @if (Model.Page.TotalCount == 0)
        {
            <div class="empty-state">
                <svg class="ico ico-lg text-muted"><use href="#i-clock"/></svg>
                <p>No activity entries match these filters.</p>
                <a class="btn btn-soft btn-sm" href="/Admin/ActivityLogs">Reset filters</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="fin-table fin-table-fixed">
                    <thead>
                        <tr>
                            @Html.SortHeader(q, "time", "When", "desc", "col-date")
                            @Html.SortHeader(q, "actor", "Who")
                            @Html.SortHeader(q, "action", "Event", "asc", "col-chip")
                            <th>What happened</th>
                            <th>IP address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Page.Items)
                        {
                            var level = l.Action.Contains("Blocked", StringComparison.OrdinalIgnoreCase) || l.Action == "AccountDeleted"
                                ? "chip-warning"
                                : l.Action.StartsWith("Admin") || l.Action.StartsWith("User") || l.Action.StartsWith("Account")
                                    ? "chip-admin"
                                    : "chip-muted";
                            <tr>
                                <td title="@l.CreatedAt.ToString("MMMM d, yyyy, h:mm:ss tt")">
                                    <span>@l.CreatedAt.ToString("MMM d, yyyy")</span>
                                    <span class="text-muted d-block">@l.CreatedAt.ToString("h:mm tt")</span>
                                </td>
                                <td title="@(l.UserId is int uid ? $"Account #{uid}" : "Not attributed to an account")">
                                    <span class="user-cell-name">@l.ActorName</span>
                                </td>
                                <td><span class="chip @level">@l.Action</span></td>
                                <td>@l.Detail</td>
                                <td class="text-muted">@l.IpAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model='Model.Page.ToPager(q, "entries")' />
        }
    </div>
</div>
