@model AdminUserFormViewModel
@{
    var currencies = Catalog.Currencies;
}

<div class="card-fin" style="max-width: 720px;">
    <div class="card-head">
        <div>
            <h2 class="card-title">@(Model.IsCreate ? "Create account" : $"Edit {Model.FullName}")</h2>
            <div class="card-sub">@(Model.IsCreate
                ? "A new account the person can sign in with immediately."
                : "Change details, role, active state — or hand out a new password.")</div>
        </div>
        <a class="btn btn-soft btn-sm" asp-action="Index"><svg class="ico-sm"><use href="#i-arrow-right"/></svg> Back to accounts</a>
    </div>
    <div class="card-body-fin">
        <div asp-validation-summary="All" class="text-danger small mb-2"></div>
        <form asp-action="@(Model.IsCreate ? "Create" : "Edit")" method="post" autocomplete="off">
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label">Full name</label>
                    <input asp-for="FullName" class="form-control" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" type="email" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label">Phone (optional)</label>
                    <input asp-for="Phone" class="form-control" placeholder="+63 9xx xxx xxxx" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Currency" class="form-label">Currency</label>
                    <select asp-for="Currency" class="form-select">
                        @foreach (var (code, name) in currencies)
                        {
                            <option value="@code" selected="@(Model.Currency == code)">@name</option>
                        }
                    </select>
                    <span asp-validation-for="Currency" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="@UserRoles.User" selected="@(Model.Role == UserRoles.User)">User — finance app only</option>
                        <option value="@UserRoles.Admin" selected="@(Model.Role == UserRoles.Admin)">Administrator — finance app + admin console</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label d-block">Account state</label>
                    <div class="form-check form-switch mt-1">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">Active — can sign in</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@(Model.IsCreate ? "Password (min 8 characters)" : "New password (leave blank to keep)")</label>
                    <input asp-for="Password" class="form-control" type="password" minlength="8" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-fin"><svg class="ico-sm"><use href="#i-check"/></svg> @(Model.IsCreate ? "Create account" : "Save changes")</button>
                <a class="btn btn-soft" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
