<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Admin Console</title>
    <link rel="icon" href="~/favicon.ico" />
    @* Restore the collapsed-sidebar preference before first paint (no flash). *@
    <script>try { if (localStorage.getItem('pfms.sidebar') === 'collapsed') document.documentElement.classList.add('sidebar-collapsed'); } catch (e) { }</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@* ---------------------------------------------------------------- SVG icon sprite *@
<svg xmlns="http://www.w3.org/2000/svg" style="display:none">
    @* Icons: Lucide v0.460.0 (https://lucide.dev, ISC license). Size/stroke come from the .ico / .ico-sm classes. *@
    <symbol id="i-dashboard" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/> <rect width="7" height="5" x="14" y="3" rx="1"/> <rect width="7" height="9" x="14" y="12" rx="1"/> <rect width="7" height="5" x="3" y="16" rx="1"/></symbol>
    <symbol id="i-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/> <circle cx="9" cy="7" r="4"/> <path d="M22 21v-2a4 4 0 0 0-3-3.87"/> <path d="M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
    <symbol id="i-tags" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 6.3 6.3a2.4 2.4 0 0 1 0 3.4L13 22.6a2.4 2.4 0 0 1-3.4 0L2.1 15.3"/> <path d="M13 5.5 16 2.6a2.1 2.1 0 0 1 3 0l2.4 2.4a2.1 2.1 0 0 1 0 3L18.5 11"/> <circle cx="11" cy="11" r="2"/></symbol>
    <symbol id="i-report" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v16a2 2 0 0 0 2 2h16"/> <path d="M18 17V9"/> <path d="M13 17V5"/> <path d="M8 17v-3"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/> <polyline points="12 6 12 12 16 14"/></symbol>
    <symbol id="i-settings" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/> <circle cx="12" cy="12" r="3"/></symbol>
    <symbol id="i-wallet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/> <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/> <path d="m9 12 2 2 4-4"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/> <polyline points="16 17 21 12 16 7"/> <line x1="21" x2="9" y1="12" y2="12"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/> <path d="M12 5v14"/></symbol>
    <symbol id="i-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/> <path d="m15 5 4 4"/></symbol>
    <symbol id="i-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/> <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/> <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/> <line x1="10" x2="10" y1="11" y2="17"/> <line x1="14" x2="14" y1="11" y2="17"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></symbol>
    <symbol id="i-circle-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/> <path d="m9 12 2 2 4-4"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/> <path d="M12 9v4"/> <path d="M12 17h.01"/></symbol>
    <symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/> <path d="m6 6 12 12"/></symbol>
    <symbol id="i-chevron-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></symbol>
    <symbol id="i-chevron-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></symbol>
    <symbol id="i-chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/> <line x1="4" x2="20" y1="6" y2="6"/> <line x1="4" x2="20" y1="18" y2="18"/></symbol>
    <symbol id="i-panel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/> <path d="M9 3v18"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/> <path d="m21 21-4.3-4.3"/></symbol>
    <symbol id="i-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/> <polyline points="7 10 12 15 17 10"/> <line x1="12" x2="12" y1="15" y2="3"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/> <circle cx="12" cy="7" r="4"/></symbol>
    <symbol id="i-user-circle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/> <circle cx="12" cy="10" r="3"/> <path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662"/></symbol>
    <symbol id="i-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/> <path d="m12 5 7 7-7 7"/></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/> <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></symbol>
    <symbol id="i-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/> <path d="M7 11V7a5 5 0 0 1 10 0v4"/></symbol>
    <symbol id="i-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/> <circle cx="12" cy="12" r="3"/></symbol>
    <symbol id="i-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/> <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/> <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/> <path d="m2 2 20 20"/></symbol>
    <symbol id="i-sort" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m21 16-4 4-4-4"/> <path d="M17 20V4"/> <path d="m3 8 4-4 4 4"/> <path d="M7 4v16"/></symbol>
    <symbol id="i-sort-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/> <path d="M12 19V5"/></symbol>
    <symbol id="i-sort-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/> <path d="m19 12-7 7-7-7"/></symbol>
    <symbol id="i-landmark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="3" x2="21" y1="22" y2="22"/> <line x1="6" x2="6" y1="18" y2="11"/> <line x1="10" x2="10" y1="18" y2="11"/> <line x1="14" x2="14" y1="18" y2="11"/> <line x1="18" x2="18" y1="18" y2="11"/> <polygon points="12 2 20 7 4 7"/></symbol>
    <symbol id="i-activity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/></symbol>
    <symbol id="i-piggy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2V5z"/> <path d="M2 9v1c0 1.1.9 2 2 2h1"/> <path d="M16 11h.01"/></symbol>
    <symbol id="i-repeat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m17 2 4 4-4 4"/> <path d="M3 11v-1a4 4 0 0 1 4-4h14"/> <path d="m7 22-4-4 4-4"/> <path d="M21 13v1a4 4 0 0 1-4 4H3"/></symbol>
</svg>

@{
    var user = ViewBag.User as User ?? new User();
    var initials = string.Join("", user.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p.Length > 0 ? p[0] : ' ')));
    var avatarInner = string.IsNullOrEmpty(user.ProfileImage)
        ? Html.Raw(System.Net.WebUtility.HtmlEncode(initials.Trim()))
        : Html.Raw($"<img src=\"{System.Net.WebUtility.HtmlEncode(user.ProfileImage)}\" alt=\"\" class=\"avatar-img\" />");
    var logo = Html.Raw("<span class=\"brand-logo brand-logo-admin\"><svg class=\"ico logo-ico\"><use href=\"#i-shield\"/></svg></span>");
}

<div class="app-shell admin-shell">
    @* -------------------------------------------------------- desktop sidebar *@
    <aside class="sidebar d-none d-lg-flex" aria-label="Admin sidebar">
        <a class="brand" asp-controller="Dashboard" asp-action="Index" title="Admin Console">
            @logo
            <span class="brand-text">Console <span class="text-brand">Admin</span></span>
        </a>

        <partial name="_AdminNav" />

        <div class="sidebar-bottom">
            <a class="nav-link-fin nav-link-secondary" asp-area="" asp-controller="Dashboard" asp-action="Index" title="Open the regular finance app">
                <svg class="ico"><use href="#i-wallet"/></svg>
                <span class="nav-text">Finance view</span>
            </a>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="nav-link-fin nav-link-danger">
                    <svg class="ico"><use href="#i-logout"/></svg>
                    <span class="nav-text">Log out</span>
                </button>
            </form>
        </div>
    </aside>

    @* -------------------------------------------------------- mobile drawer *@
    <div class="offcanvas offcanvas-start mobile-drawer d-lg-none" tabindex="-1" id="mobileNav" aria-label="Menu">
        <div class="drawer-head">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">
                @logo
                <span class="brand-text">Console <span class="text-brand">Admin</span></span>
            </a>
            <button type="button" class="icon-btn" data-bs-dismiss="offcanvas" aria-label="Close menu"><svg class="ico-sm"><use href="#i-x"/></svg></button>
        </div>
        <partial name="_AdminNav" />
    </div>

    <div class="app-main">
        @* ---------------------------------------------------- top bar *@
        <header class="app-topbar">
            <div class="topbar-left">
                <button type="button" class="icon-btn d-none d-lg-grid" data-sidebar-toggle aria-label="Toggle sidebar" title="Toggle sidebar">
                    <svg class="ico-sm"><use href="#i-panel"/></svg>
                </button>
                <button type="button" class="icon-btn d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-label="Open menu">
                    <svg class="ico-sm"><use href="#i-menu"/></svg>
                </button>
                <span class="topbar-divider" aria-hidden="true"></span>
                <nav aria-label="Breadcrumb" class="crumbs">
                    <span class="chip chip-admin d-none d-sm-inline" title="You are in the Admin Console">Admin</span>
                    <a asp-controller="Dashboard" asp-action="Index" class="crumb-home d-none d-sm-inline">Console</a>
                    <svg class="ico-sm crumb-sep d-none d-sm-inline" aria-hidden="true"><use href="#i-chevron-right"/></svg>
                    <span class="crumb-current" aria-current="page">@ViewData["Title"]</span>
                </nav>
            </div>

            <div class="topbar-actions">
                <div class="dropdown">
                    <button type="button" class="account-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                        <span class="avatar avatar-sm">@avatarInner</span>
                        <span class="account-text d-none d-md-flex">
                            <span class="account-name">@user.FullName</span>
                            <span class="account-mail">@user.Email</span>
                        </span>
                        <svg class="ico-sm account-chevron d-none d-md-block"><use href="#i-chevron-down"/></svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end menu-fin account-menu">
                        <li class="menu-user">
                            <span class="avatar">@avatarInner</span>
                            <span class="menu-user-text">
                                <span class="menu-user-name">@user.FullName</span>
                                <span class="menu-user-mail">@user.Email</span>
                            </span>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><span class="menu-ico"><svg class="ico-sm"><use href="#i-settings"/></svg></span>Admin settings</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Dashboard" asp-action="Index"><span class="menu-ico"><svg class="ico-sm"><use href="#i-wallet"/></svg></span>Finance view</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="dropdown-item text-danger"><span class="menu-ico"><svg class="ico-sm"><use href="#i-logout"/></svg></span>Log out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="app-content">
            @* The breadcrumb above carries the page title; only a visually-hidden h1 here. *@
            <h1 class="visually-hidden">@ViewData["Title"]</h1>
            @if (ViewData["Subtitle"] is string sub && sub.Length > 0)
            {
                <div class="page-header">
                    <p class="page-sub">@sub</p>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>

@* -------------------------------------------------------- toast notifications (bottom-left, auto-dismiss) *@
<div class="toast-stack" id="toastStack" aria-live="polite" aria-relevant="additions">
    @if (TempData["Success"] is string ok)
    {
        <div class="toast-fin is-success" role="status" data-duration="5000">
            <span class="toast-ico"><svg class="ico-sm"><use href="#i-check"/></svg></span>
            <span class="toast-body"><span class="toast-title">@(TempData["ToastTitle"] as string ?? "Success")</span><span class="toast-msg">@ok</span></span>
            <button type="button" class="toast-close" aria-label="Dismiss notification"><svg class="ico-sm"><use href="#i-x"/></svg></button>
            <span class="toast-timer" aria-hidden="true"></span>
        </div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="toast-fin is-error" role="alert" data-duration="8000">
            <span class="toast-ico"><svg class="ico-sm"><use href="#i-alert"/></svg></span>
            <span class="toast-body"><span class="toast-title">@(TempData["ToastTitle"] as string ?? "Something went wrong")</span><span class="toast-msg">@err</span></span>
            <button type="button" class="toast-close" aria-label="Dismiss notification"><svg class="ico-sm"><use href="#i-x"/></svg></button>
            <span class="toast-timer" aria-hidden="true"></span>
        </div>
    }
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
