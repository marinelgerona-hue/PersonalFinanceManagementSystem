@model AdminCategoryFormViewModel

<div class="card-fin" style="max-width: 560px;">
    <div class="card-head">
        <div>
            <h2 class="card-title">@(Model.IsCreate ? "New category" : $"Edit {Model.Name}")</h2>
            <div class="card-sub">@(Model.IsCreate
                ? "Adds a choice to every user's income or expense picker."
                : "Change the name, type or visibility of this catalog entry.")</div>
        </div>
        <a class="btn btn-soft btn-sm" asp-action="Index"><svg class="ico-sm"><use href="#i-arrow-right"/></svg> Back to categories</a>
    </div>
    <div class="card-body-fin">
        <div asp-validation-summary="All" class="text-danger small mb-2"></div>
        <form asp-action="@(Model.IsCreate ? "Create" : "Edit")" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-12">
                    <span class="form-label d-block mb-2">Type</span>
                    <div class="btn-group w-100" role="group" aria-label="Category type">
                        <input type="radio" class="btn-check" name="Type" id="type-income" value="@((int)CategoryType.Income)"
                               checked="@(Model.Type == CategoryType.Income)" />
                        <label class="btn btn-soft" for="type-income"><svg class="ico-sm"><use href="#i-income"/></svg> Income source</label>
                        <input type="radio" class="btn-check" name="Type" id="type-expense" value="@((int)CategoryType.Expense)"
                               checked="@(Model.Type == CategoryType.Expense)" />
                        <label class="btn btn-soft" for="type-expense"><svg class="ico-sm"><use href="#i-expense"/></svg> Expense category</label>
                    </div>
                    <span asp-validation-for="Type" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" required maxlength="100"
                           placeholder="@Model.Type == CategoryType.Income ? "e.g. Salary" : "e.g. Groceries"" value="@Model.Name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">Active — visible in user pickers</label>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-fin"><svg class="ico-sm"><use href="#i-check"/></svg> @(Model.IsCreate ? "Add category" : "Save changes")</button>
                <a class="btn btn-soft" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
