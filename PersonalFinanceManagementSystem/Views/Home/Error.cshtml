@{
    ViewData["Title"] = "Error";
}

<div class="auth-card text-center">
    <div class="auth-brand">
        <span class="brand-logo" style="background:linear-gradient(135deg,#f43f5e,#f59e0b)">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
        </span>
    </div>
    <h1 class="auth-title">Something went wrong</h1>
    <p class="auth-sub">An unexpected error occurred while processing your request. Please try again.</p>
    <a class="btn btn-fin w-100" asp-controller="Home" asp-action="Index">Back to Finance Management</a>
</div>
