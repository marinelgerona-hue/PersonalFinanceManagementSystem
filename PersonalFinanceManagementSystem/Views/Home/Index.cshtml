@{
    ViewData["Title"] = "Welcome";
}

<div class="landing">
    <div class="landing-inner">

        <div class="landing-brand">
            <span class="brand-logo"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M16 12h4" /></svg></span>
            <span>Finance <span class="text-brand">Management</span></span>
        </div>

        <h1 class="landing-title">Welcome to my Finance Management</h1>
        <p class="landing-sub">
            Track your income, expenses, budgets and savings goals — all in one place.
        </p>

        <div class="landing-actions">
            <a class="btn btn-outline-light-ghost btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
            <a class="btn btn-fin btn-lg" asp-controller="Account" asp-action="Register">Get started</a>
        </div>

        <div class="landing-features">
            <div class="landing-feature">
                <span class="stat-icon tint-green"><svg class="ico"><use href="#i-income" /></svg></span>
                <div>
                    <div class="landing-feature-title">Income tracking</div>
                    <div class="landing-feature-text">Log every peso you earn, by source.</div>
                </div>
            </div>
            <div class="landing-feature">
                <span class="stat-icon tint-red"><svg class="ico"><use href="#i-expense" /></svg></span>
                <div>
                    <div class="landing-feature-title">Expense tracking</div>
                    <div class="landing-feature-text">See where your money goes each month.</div>
                </div>
            </div>
            <div class="landing-feature">
                <span class="stat-icon tint-amber"><svg class="ico"><use href="#i-budget" /></svg></span>
                <div>
                    <div class="landing-feature-title">Budgets &amp; goals</div>
                    <div class="landing-feature-text">Set limits and save for what matters.</div>
                </div>
            </div>
            <div class="landing-feature">
                <span class="stat-icon tint-sky"><svg class="ico"><use href="#i-report" /></svg></span>
                <div>
                    <div class="landing-feature-title">Reports</div>
                    <div class="landing-feature-text">Monthly and annual insights at a glance.</div>
                </div>
            </div>
        </div>

    </div>
</div>
