@model GoalFormViewModel
@{
    var isEdit = Model.Id > 0;
}

<div class="form-card card-fin">
    <div class="card-head">
        <div>
            <h2 class="card-title">Goal details</h2>
            <div class="card-sub">Name what you're saving for and set a target</div>
        </div>
    </div>

    <div class="card-body-fin">
        <div asp-validation-summary="ModelOnly" class="banner banner-error"></div>

        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Goal name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Emergency Fund" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="row g-3">
                <div class="col-md-6 col-xl-4">
                    <label asp-for="TargetAmount" class="form-label">Target amount</label>
                    <div class="input-group">
                        <span class="input-group-text">@Format.Symbol(ViewBag.User?.Currency)</span>
                        <input asp-for="TargetAmount" type="number" step="0.01" min="1" class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                </div>
                <div class="col-md-6 col-xl-4">
                    <label asp-for="Deadline" class="form-label">Target date <span class="text-muted fw-normal">(optional)</span></label>
                    <input asp-for="Deadline" type="date" class="form-control" />
                    <span asp-validation-for="Deadline" class="text-danger small"></span>
                </div>
            </div>
            <div class="mt-3">
                <label asp-for="Note" class="form-label">Note <span class="text-muted fw-normal">(optional)</span></label>
                <input asp-for="Note" class="form-control" placeholder="Why is this goal important?" />
                <span asp-validation-for="Note" class="text-danger small"></span>
            </div>
            <div class="form-actions">
                <a class="btn btn-soft" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-fin">@(isEdit ? "Save changes" : "Create goal")</button>
            </div>
        </form>
    </div>
</div>
