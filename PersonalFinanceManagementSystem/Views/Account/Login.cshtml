@model LoginViewModel

@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-shell">
    <partial name="_AuthAside" />

    <section class="auth-panel">
        <div class="auth-brand auth-brand-mobile">
            <span class="brand-logo"><svg class="ico logo-ico"><use href="#i-wallet"/></svg></span>
            <span>Finance <span class="text-brand">Management</span></span>
        </div>

        <h1 class="auth-title">Sign in to your account</h1>
        <p class="auth-sub">Enter your email and password to continue.</p>

        <!-- Validation errors -->
        <div asp-validation-summary="ModelOnly"
             class="banner banner-error">
        </div>

        <!-- Login Form -->
        <form asp-action="Login"
              method="post"
              novalidate
              class="auth-form">

            <div class="field">
                <label asp-for="Email" class="form-label"></label>
                <div class="field-control">
                    <svg class="field-icon" aria-hidden="true"><use href="#i-mail"/></svg>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="name@company.com"
                           autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Password" class="form-label"></label>
                <div class="field-control">
                    <svg class="field-icon" aria-hidden="true"><use href="#i-lock"/></svg>
                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Enter your password"
                           autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <!-- Remember me: persistent sign-in across browser restarts -->
            <div class="field field-inline">
                <div class="form-check">
                    <input asp-for="RememberMe"
                           type="checkbox"
                           class="form-check-input"
                           value="true" />
                    <label asp-for="RememberMe"
                           class="form-check-label">
                        Keep me signed in for 30 days
                    </label>
                </div>
            </div>

            <button type="submit"
                    class="btn btn-fin auth-submit w-100">
                Sign in
            </button>

        </form>

        <p class="auth-alt">
            New to Finance Management?
            <a asp-action="Register">Create an account</a>
        </p>
    </section>
</div>
