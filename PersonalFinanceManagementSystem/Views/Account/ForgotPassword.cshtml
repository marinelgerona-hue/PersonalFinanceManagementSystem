@model ForgotPasswordViewModel
@{
    var isAdministrator = Model.Role == UserRoles.Admin;
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-shell">
    <partial name="_AuthAside" />
    <section class="auth-panel">
        <div class="auth-brand auth-brand-mobile">
            <span class="brand-logo"><svg class="ico logo-ico"><use href="#i-wallet" /></svg></span>
            <span>Finance <span class="text-brand">Management</span></span>
        </div>
        <h1 class="auth-title">Forgot Password?</h1>
        <p class="auth-sub">Enter the login email for the account to recover. A 6-digit verification code will be sent to the recovery email.</p>
        @if (ViewData["ResetNotice"] is string resetNotice)
        {
            <div class="banner banner-info" role="status">@resetNotice</div>
        }
        <div asp-validation-summary="ModelOnly" class="banner banner-error"></div>
        <form asp-action="ForgotPassword" method="post" novalidate class="auth-form">
            <input type="hidden" asp-for="Role" />
            <div class="field">
                <label asp-for="Email" class="form-label"></label>
                <div class="field-control">
                    <svg class="field-icon" aria-hidden="true"><use href="#i-mail" /></svg>
                    <input asp-for="Email" class="form-control" placeholder="name@company.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-fin auth-submit w-100">Send verification code</button>
        </form>
        <p class="auth-alt"><a asp-action="Login" asp-route-role="@Model.Role">Back to @(isAdministrator ? "Administrator Login" : "Sign in")</a></p>
    </section>
</div>
