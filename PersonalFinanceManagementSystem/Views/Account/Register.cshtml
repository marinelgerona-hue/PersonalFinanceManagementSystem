@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<div class="auth-shell">
    <partial name="_AuthAside" />

    <section class="auth-panel">
        <div class="auth-brand auth-brand-mobile">
            <span class="brand-logo"><svg class="ico logo-ico"><use href="#i-wallet"/></svg></span>
            <span>Finance <span class="text-brand">Management</span></span>
        </div>
        <h1 class="auth-title">Create your account</h1>
        <p class="auth-sub">It's free and takes less than a minute.</p>

        <div asp-validation-summary="ModelOnly" class="banner banner-error"></div>

        <form asp-action="Register" method="post" novalidate class="auth-form">
            <div class="auth-grid">
                <div class="field">
                    <label asp-for="FullName" class="form-label"></label>
                    <div class="field-control">
                        <svg class="field-icon" aria-hidden="true"><use href="#i-user"/></svg>
                        <input asp-for="FullName" class="form-control" placeholder="Your name" autocomplete="name" />
                    </div>
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="field-control">
                        <svg class="field-icon" aria-hidden="true"><use href="#i-mail"/></svg>
                        <input asp-for="Email" class="form-control" placeholder="name@company.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Phone" class="form-label">Phone <span class="label-optional">Optional</span></label>
                    <div class="phone-control">
                        <select asp-for="PhoneCountry" class="phone-country" aria-label="Country code" autocomplete="tel-country-code">
                            @foreach (var (iso, name, dial, flag) in Catalog.PhoneCountries)
                            {
                                <option value="@iso" data-flag="@flag" data-dial="@dial" data-name="@name" selected="@(iso == Model.PhoneCountry)">@flag @name (@dial)</option>
                            }
                        </select>
                        <input asp-for="Phone" class="form-control" placeholder="Mobile number" autocomplete="tel-national" inputmode="tel" />
                    </div>
                    <span asp-validation-for="Phone" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Currency" class="form-label"></label>
                    <div class="field-control">
                        <svg class="field-icon" aria-hidden="true"><use href="#i-dollar"/></svg>
                        <select asp-for="Currency" class="form-select">
                            @foreach (var (code, name) in Catalog.Currencies)
                            {
                                <option value="@code" selected="@(code == Model.Currency)">@name</option>
                            }
                        </select>
                    </div>
                    <span asp-validation-for="Currency" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="field-control">
                        <svg class="field-icon" aria-hidden="true"><use href="#i-lock"/></svg>
                        <input asp-for="Password" class="form-control" placeholder="Create password" autocomplete="new-password" data-strength-meter="pw-strength" />
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="field-control">
                        <svg class="field-icon" aria-hidden="true"><use href="#i-lock-check"/></svg>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
            </div>

            <div class="pw-strength" id="pw-strength" aria-live="polite">
                <div class="pw-bars"><span></span><span></span><span></span><span></span></div>
                <span class="pw-label">Use at least 6 characters with a mix of letters, numbers &amp; symbols.</span>
            </div>

            <button type="submit" class="btn btn-fin auth-submit w-100">Create account</button>
        </form>

        <p class="auth-alt">Already have an account? <a asp-action="Login">Sign in</a></p>
    </section>
</div>
