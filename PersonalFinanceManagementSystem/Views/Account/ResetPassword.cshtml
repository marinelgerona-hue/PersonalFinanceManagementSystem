@model ResetPasswordViewModel
@{
    var isAdministrator = Model.Role == UserRoles.Admin;
    ViewData["Title"] = "Reset Password";
}

<div class="auth-shell">
    <partial name="_AuthAside" />
    <section class="auth-panel">
        <div class="auth-brand auth-brand-mobile">
            <span class="brand-logo"><svg class="ico logo-ico"><use href="#i-wallet" /></svg></span>
            <span>Finance <span class="text-brand">Management</span></span>
        </div>
        <h1 class="auth-title">Reset Password</h1>
        <p class="auth-sub">Create a new password for your account.</p>
        <div asp-validation-summary="ModelOnly" class="banner banner-error"></div>
        <form asp-action="ResetPassword" method="post" novalidate class="auth-form">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Role" />
            <div class="field">
                <label asp-for="NewPassword" class="form-label"></label>
                <div class="field-control">
                    <svg class="field-icon" aria-hidden="true"><use href="#i-lock" /></svg>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Enter a new password" />
                </div>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="field-control">
                    <svg class="field-icon" aria-hidden="true"><use href="#i-lock-check" /></svg>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat your new password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-fin auth-submit w-100">Reset password</button>
        </form>
        <p class="auth-alt"><a asp-action="Login" asp-route-role="@Model.Role">Back to @(isAdministrator ? "Administrator Login" : "Sign in")</a></p>
    </section>
</div>
