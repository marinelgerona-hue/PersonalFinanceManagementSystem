@model IncomeListViewModel
@{
    var cur = Model.Currency;

    // Speed of each income kind, used for the “per period” caption.
    string PeriodCaption(IncomePeriod p) => p switch
    {
        IncomePeriod.Daily => "per day",
        IncomePeriod.Weekly => "per week",
        IncomePeriod.Yearly => "per year",
        _ => "per month"
    };
}

@{
    var recordCount = Model.PeriodBreakdown.Sum(p => p.Count);

    // Remaining-balance cards appear for all four income periods; periods
    // without income (or expenses) read from an empty slice at zero.
    var byPeriod = Model.PeriodBreakdown.ToDictionary(p => p.Period);
    IncomePeriod[] balancePeriods = { IncomePeriod.Daily, IncomePeriod.Weekly, IncomePeriod.Monthly, IncomePeriod.Yearly };
    PeriodSlice PeriodSlice(IncomePeriod period) =>
        byPeriod.TryGetValue(period, out var slice)
            ? slice
            : new PeriodSlice { Period = period, Label = period.ToString() };

    // Same tint mapping the breakdown uses — by period, so cards without
    // records still get their color.
    string TintFor(IncomePeriod p) => p switch
    {
        IncomePeriod.Daily => "tint-sky",
        IncomePeriod.Weekly => "tint-amber",
        IncomePeriod.Yearly => "tint-indigo",
        _ => "tint-green"
    };
}
<section class="kpi-grid mb-3" id="income-period-cards">
    <article class="kpi">
        <div class="kpi-head">
            <span class="kpi-icon tint-green"><svg class="ico"><use href="#i-income"/></svg></span>
            <span class="kpi-label">Received this month</span>
        </div>
        <div class="kpi-value">@Format.Money(Model.MonthTotal, cur)</div>
        <div class="kpi-foot">@Model.ThisMonthCount record@(Model.ThisMonthCount == 1 ? "" : "s") this month</div>
    </article>
    <article class="kpi">
        <div class="kpi-head">
            <span class="kpi-icon tint-indigo"><svg class="ico"><use href="#i-wallet"/></svg></span>
            <span class="kpi-label">All-time income</span>
        </div>
        <div class="kpi-value">@Format.Money(Model.Total, cur)</div>
        <div class="kpi-foot">@recordCount record@(recordCount == 1 ? "" : "s") in total</div>
    </article>
    <article class="kpi kpi-span-2">
        <div class="kpi-head">
            <span class="kpi-icon tint-sky"><svg class="ico"><use href="#i-calendar"/></svg></span>
            <span class="kpi-label">By income type</span>
        </div>
        @if (Model.PeriodBreakdown.Count == 0)
        {
            <div class="kpi-foot mt-3">No income recorded yet.</div>
        }
        else
        {
            <ul class="kpi-breakdown">
                @foreach (var ps in Model.PeriodBreakdown)
                {
                    <li>
                        <span class="kpi-breakdown-name">@ps.Label</span>
                        <span class="kpi-breakdown-meta">@ps.Count record@(ps.Count == 1 ? "" : "s") · @PeriodCaption(ps.Period)</span>
                        <span class="kpi-breakdown-amt">@Format.Money(ps.Total, cur)</span>
                    </li>
                }
            </ul>
        }
    </article>
</section>

@* Remaining balance per income period: every card reads its income,
   deducted expenses and remaining balance straight from the database, so
   adding/editing/deleting income or expenses updates them on the next
   page load. Expenses with no income pool (records saved before the pool
   feature existed) belong to no card — they only reduce the all-time
   totals above, never a period balance. *@
<section class="kpi-grid mb-3" id="income-remaining-cards">
    @foreach (var period in balancePeriods)
    {
        var balance = PeriodSlice(period);
        <article class="kpi">
            <div class="kpi-head">
                <span class="kpi-icon @TintFor(period)"><svg class="ico"><use href="#i-wallet"/></svg></span>
                <span class="kpi-label">@balance.Label remaining balance</span>
            </div>
            <div class="kpi-value">@Format.Money(balance.Remaining, cur)</div>
            <div class="kpi-foot">@Format.Money(balance.Total, cur) income · @Format.Money(balance.Spent, cur) expensed</div>
        </article>
    }
    <article class="kpi" style="grid-column:1/-1">
        <div class="kpi-head">
            <span class="kpi-icon tint-green"><svg class="ico"><use href="#i-check"/></svg></span>
            <span class="kpi-label">Total remaining balance</span>
        </div>
        <div class="kpi-value">@Format.Money(Model.TotalRemaining, cur)</div>
        <div class="kpi-foot">@Format.Money(Model.SumByPeriod(p => p.Total), cur) income · @Format.Money(Model.SumByPeriod(p => p.Spent), cur) expensed across @Model.PeriodBreakdown.Count income type@(Model.PeriodBreakdown.Count == 1 ? "" : "s")</div>
    </article>
</section>

<div class="card-fin">
    <div class="card-head flex-wrap gap-2">
        <div>
            <h2 class="card-title">@(Model.PeriodFilter is null ? "Income Records" : Model.PeriodFilter + " Income")</h2>
            <div class="card-sub">@Model.Page.TotalCount record@(Model.Page.TotalCount == 1 ? "" : "s")@(Model.Query.Search.Length > 0 ? $" matching “{Model.Query.Search}”" : "") · totals update automatically</div>
        </div>
        <div class="report-pill-group" style="box-shadow:none">
            <a class="report-pill @(Model.PeriodFilter is null ? "active" : "")" asp-action="Index">All</a>
            <a class="report-pill @(Model.PeriodFilter == IncomePeriod.Daily ? "active" : "")" asp-action="Index" asp-route-period="@IncomePeriod.Daily">Daily</a>
            <a class="report-pill @(Model.PeriodFilter == IncomePeriod.Weekly ? "active" : "")" asp-action="Index" asp-route-period="@IncomePeriod.Weekly">Weekly</a>
            <a class="report-pill @(Model.PeriodFilter == IncomePeriod.Monthly ? "active" : "")" asp-action="Index" asp-route-period="@IncomePeriod.Monthly">Monthly</a>
            <a class="report-pill @(Model.PeriodFilter == IncomePeriod.Yearly ? "active" : "")" asp-action="Index" asp-route-period="@IncomePeriod.Yearly">Yearly</a>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-soft" asp-action="Export"><svg class="ico-sm"><use href="#i-download"/></svg> Export Excel</a>
            <a class="btn btn-fin" asp-action="Create"><svg class="ico-sm"><use href="#i-plus"/></svg> Add Income</a>
        </div>
    </div>

    <div class="list-toolbar">
        @{ ViewData["SearchPlaceholder"] = "Search source, period or note…"; }
        <partial name="_ListToolbar" model="Model.Query" />
    </div>

    <div class="table-responsive">
        @if (Model.Page.TotalCount == 0 && Model.Query.Search.Length > 0)
        {
            <div class="empty-state">
                <svg class="ico ico-lg text-muted"><use href="#i-search"/></svg>
                <p>No income matches “@Model.Query.Search”.</p>
                <a class="btn btn-soft btn-sm" href="@Context.Request.WithQuery(("q", null), ("page", null))">Clear search</a>
            </div>
        }
        else if (Model.Page.TotalCount == 0)
        {
            <div class="empty-state">
                <svg class="ico ico-lg text-muted"><use href="#i-income"/></svg>
                <p>No income yet. Add your first income record to get started.</p>
            </div>
        }
        else
        {
            <table class="fin-table fin-table-fixed">
                <thead>
                    <tr>
                        @Html.SortHeader(Model.Query, "date", "Date", "desc", "col-date")
                        @Html.SortHeader(Model.Query, "source", "Source", "asc", "col-chip")
                        @Html.SortHeader(Model.Query, "period", "Period", "asc", "col-chip-sm")
                        @Html.SortHeader(Model.Query, "note", "Note")
                        @Html.SortHeader(Model.Query, "amount", "Amount", "desc", "text-end col-amount")
                        <th class="text-end col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Page.Items)
                    {
                        <tr>
                            <td class="text-nowrap text-muted">@Format.Date(item.Date)</td>
                            <td>
                                <span class="chip"><span class="dot" style="background:@Format.CategoryColor(item.Source)"></span>@item.Source</span>
                            </td>
                            <td>
                                <span class="chip"><span class="dot" style="background:@Format.CategoryColor(item.Period.ToString())"></span>@item.Period</span>
                            </td>
                            <td class="text-muted note-cell">@(string.IsNullOrWhiteSpace(item.Note) ? "—" : item.Note)</td>
                            <td class="text-end amount pos">+@Format.Money(item.Amount, cur)</td>
                            <td class="text-end text-nowrap">
                                <a class="btn-icon" asp-action="Edit" asp-route-id="@item.Id" title="Edit"><svg class="ico-sm"><use href="#i-edit"/></svg></a>
                                <form class="d-inline" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this income record?');">
                                    <button type="submit" class="btn-icon danger" title="Delete"><svg class="ico-sm"><use href="#i-trash"/></svg></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (Model.Page.TotalCount > 0)
    {
        <partial name="_Pagination" model="Model.Page.ToPager(Model.Query)" />
    }
</div>
