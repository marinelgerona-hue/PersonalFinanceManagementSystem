@model IncomeFormViewModel
@{
    var isEdit = Model.Id > 0;
}

<div class="form-card card-fin">
    <div class="card-head">
        <div>
            <h2 class="card-title">@(isEdit ? "Edit Income" : "Add Income")</h2>
            <div class="card-sub">Source, amount, date and an optional note</div>
        </div>
        <a class="btn btn-soft btn-sm" asp-action="Index">Cancel</a>
    </div>

    <div class="card-body-fin">
        <div asp-validation-summary="ModelOnly" class="banner banner-error"></div>

        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Source" class="form-label">Income source</label>
                    <select asp-for="Source" class="form-select">
                        <option value="">Choose a source…</option>
                        @foreach (var source in Catalog.IncomeSources)
                        {
                            <option value="@source" selected="@(source == Model.Source)">@source</option>
                        }
                    </select>
                    <span asp-validation-for="Source" class="text-danger small"></span>

                    @* Shown only while "Other" is selected; the typed value
                       becomes the saved income source (custom-source row). *@
                    <div id="customSourceField" class="mt-2" style="display:none">
                        <label for="CustomSource" class="form-label">Custom source</label>
                        <input asp-for="CustomSource" type="text" class="form-control"
                               placeholder="e.g. Publication royalties" maxlength="100"
                               data-val="true" data-val-required="Please enter your income source." />
                        <span asp-validation-for="CustomSource" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Period" class="form-label">Income period</label>
                    <select asp-for="Period" class="form-select">
                        <option value="@IncomePeriod.Daily" selected="@(Model.Period == IncomePeriod.Daily)">Daily</option>
                        <option value="@IncomePeriod.Weekly" selected="@(Model.Period == IncomePeriod.Weekly)">Weekly</option>
                        <option value="@IncomePeriod.Monthly" selected="@(Model.Period == IncomePeriod.Monthly)">Monthly</option>
                        <option value="@IncomePeriod.Yearly" selected="@(Model.Period == IncomePeriod.Yearly)">Yearly</option>
                    </select>
                    <span asp-validation-for="Period" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Amount" class="form-label">Amount</label>
                    <div class="input-group">
                        <span class="input-group-text">@Format.Symbol(ViewBag.User?.Currency)</span>
                        <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Date" class="form-label">Date</label>
                    <input asp-for="Date" type="date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Note" class="form-label">Note <span class="text-muted fw-normal">(optional)</span></label>
                    <input asp-for="Note" class="form-control" placeholder="e.g. October salary" />
                    <span asp-validation-for="Note" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-fin">@(isEdit ? "Save changes" : "Add income")</button>
                <a class="btn btn-soft" asp-action="Index">Back to list</a>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    var sourceSelect = document.getElementById('Source');
    var field = document.getElementById('customSourceField');
    var input = document.getElementById('CustomSource');
    if (!sourceSelect || !field) return;

    // The custom source field lives directly under the source select and is
    // shown only while "Other" is picked — matching the pre-set layout.
    function updateCustomSourceField() {
        if (sourceSelect.value === 'Other') {
            field.style.display = '';
        } else {
            field.style.display = 'none';
            if (input) input.value = ''; // never submit stale custom text
        }
    }

    sourceSelect.addEventListener('change', updateCustomSourceField);

    updateCustomSourceField();
})();
</script>
