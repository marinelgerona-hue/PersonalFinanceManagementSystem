@model DashboardViewModel
@{
    var cur = Model.Currency;
    var donutR = 48d;
    var donutC = 2 * Math.PI * donutR;
}

<div class="row g-3">
    @* ------------------------------------------------ stat cards *@
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Balance</div>
                    <div class="stat-value">@Format.Money(Model.Balance, cur)</div>
                    <div class="stat-foot">@Format.Money(Model.TotalIncome, cur) in − @Format.Money(Model.TotalExpenses, cur) out</div>
                </div>
                <span class="stat-icon tint-indigo"><svg class="ico"><use href="#i-wallet"/></svg></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Income · @Model.MonthLabel</div>
                    <div class="stat-value text-pos">@Format.Money(Model.MonthlyIncome, cur)</div>
                    <div class="stat-foot">received this month</div>
                </div>
                <span class="stat-icon tint-green"><svg class="ico"><use href="#i-income"/></svg></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Expenses · @Model.MonthLabel</div>
                    <div class="stat-value text-neg">@Format.Money(Model.MonthlyExpenses, cur)</div>
                    <div class="stat-foot">spent this month</div>
                </div>
                <span class="stat-icon tint-red"><svg class="ico"><use href="#i-expense"/></svg></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <div>
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Savings Progress</div>
                        <div class="stat-value">@Format.Money(Model.TotalSaved, cur)</div>
                        <div class="stat-foot">of @Format.Money(Model.SavingsTarget, cur) goal target</div>
                    </div>
                    <span class="stat-icon tint-sky"><svg class="ico"><use href="#i-piggy"/></svg></span>
                </div>
                <div class="progress-track mt-2">
                    <div class="progress-fill" style="width:@Format.Pct(Math.Min(Model.SavingsPercent, 100))%"></div>
                </div>
                <div class="stat-foot mt-1">@Format.Pct(Model.SavingsPercent)% saved</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-0">
    @* ------------------------------------------------ spending overview (donut) *@
    <div class="col-lg-5">
        <div class="card-fin h-100">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Spending Overview</h2>
                    <div class="card-sub">@Model.MonthLabel · by category</div>
                </div>
                <a class="btn btn-soft btn-sm" asp-controller="Expenses" asp-action="Index">View all</a>
            </div>
            <div class="card-body-fin">
                @if (Model.Spending.Count == 0)
                {
                    <div class="empty-state">
                        <svg class="ico ico-lg text-muted"><use href="#i-budget"/></svg>
                        <p>No expenses recorded for @Model.MonthLabel yet.</p>
                        <a class="btn btn-fin btn-sm" asp-controller="Expenses" asp-action="Create"><svg class="ico-sm"><use href="#i-plus"/></svg> Add expense</a>
                    </div>
                }
                else
                {
                    var total = Model.SpendingTotal;
                    var offset = 0d;
                    <div class="d-flex flex-column flex-sm-row align-items-center gap-4">
                        <div class="donut-wrap">
                            <svg viewBox="0 0 120 120" class="donut">
                                <circle cx="60" cy="60" r="48" fill="none" stroke="#eef2f7" stroke-width="18"/>
                                @foreach (var s in Model.Spending)
                                {
                                    var len = (double)(s.Amount / total) * donutC;
                                    <circle cx="60" cy="60" r="48" fill="none" stroke="@Format.CategoryColor(s.Category)" stroke-width="18"
                                            stroke-dasharray="@Format.Num(len) @Format.Num(donutC - len)"
                                            stroke-dashoffset="@Format.Num(-offset)"/>
                                    offset += len;
                                }
                                <text x="60" y="56" text-anchor="middle" class="donut-value">@Format.Money0(total, cur)</text>
                                <text x="60" y="72" text-anchor="middle" class="donut-caption">this month</text>
                            </svg>
                        </div>
                        <ul class="legend list-unstyled flex-grow-1 w-100">
                            @foreach (var s in Model.Spending)
                            {
                                <li class="legend-row">
                                    <span class="dot" style="background:@Format.CategoryColor(s.Category)"></span>
                                    <span class="legend-name">@s.Category</span>
                                    <span class="legend-amount">@Format.Money(s.Amount, cur)</span>
                                    <span class="legend-pct">@Format.Pct(s.Percent)%</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ------------------------------------------------ income vs expenses (6 months) *@
    <div class="col-lg-7">
        <div class="card-fin h-100">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Income vs Expenses</h2>
                    <div class="card-sub">last 6 months</div>
                </div>
                <div class="chart-key">
                    <span><i class="key key-income"></i> Income</span>
                    <span><i class="key key-expense"></i> Expenses</span>
                </div>
            </div>
            <div class="card-body-fin">
                @if (Model.TrendMax <= 0)
                {
                    <div class="empty-state">
                        <svg class="ico ico-lg text-muted"><use href="#i-report"/></svg>
                        <p>Add income and expenses to see your monthly trend here.</p>
                    </div>
                }
                else
                {
                    <div class="bar-chart">
                        @foreach (var t in Model.Trend)
                        {
                            var ih = Model.TrendMax > 0 ? (double)(t.Income / Model.TrendMax) * 100 : 0;
                            var eh = Model.TrendMax > 0 ? (double)(t.Expenses / Model.TrendMax) * 100 : 0;
                            <div class="bar-group" title="@t.Label: income @Format.Money(t.Income, cur), expenses @Format.Money(t.Expenses, cur)">
                                <div class="bar-pair">
                                    <div class="bar income" style="height:@Format.Pct((decimal)ih)%"></div>
                                    <div class="bar expense" style="height:@Format.Pct((decimal)eh)%"></div>
                                </div>
                                <span class="bar-label">@t.Label</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ------------------------------------------------ savings goals *@
    <div class="col-lg-6">
        <div class="card-fin h-100">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Savings Goals</h2>
                    <div class="card-sub">@Model.Goals.Count goal@(Model.Goals.Count == 1 ? "" : "s") in progress</div>
                </div>
                <a class="btn btn-soft btn-sm" asp-controller="Goals" asp-action="Index">Manage</a>
            </div>
            <div class="card-body-fin">
                @if (Model.Goals.Count == 0)
                {
                    <div class="empty-state">
                        <svg class="ico ico-lg text-muted"><use href="#i-goal"/></svg>
                        <p>No savings goals yet. Set your first goal!</p>
                        <a class="btn btn-fin btn-sm" asp-controller="Goals" asp-action="Create"><svg class="ico-sm"><use href="#i-plus"/></svg> New goal</a>
                    </div>
                }
                else
                {
                    @foreach (var g in Model.Goals)
                    {
                        <div class="goal-row">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold">@g.Goal.Name</span>
                                <span class="small text-muted">@Format.Money(g.Saved, cur) / @Format.Money(g.Target, cur)</span>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width:@Format.Pct(Math.Min(g.Percent, 100))%"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <span class="small text-muted">@Format.Pct(g.Percent)% reached</span>
                                @if (g.Completed)
                                {
                                    <span class="chip chip-success">Completed</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* ------------------------------------------------ budget summary *@
    <div class="col-lg-6">
        <div class="card-fin h-100">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Budget Summary</h2>
                    <div class="card-sub">@Model.MonthLabel</div>
                </div>
                <a class="btn btn-soft btn-sm" asp-controller="Budgets" asp-action="Index">Manage</a>
            </div>
            <div class="card-body-fin">
                @if (Model.Budgets.Count == 0)
                {
                    <div class="empty-state">
                        <svg class="ico ico-lg text-muted"><use href="#i-budget"/></svg>
                        <p>No budgets for @Model.MonthLabel yet.</p>
                        <a class="btn btn-fin btn-sm" asp-controller="Budgets" asp-action="Create"><svg class="ico-sm"><use href="#i-plus"/></svg> Add budget</a>
                    </div>
                }
                else
                {
                    @foreach (var b in Model.Budgets)
                    {
                        <div class="budget-row">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="legend-row m-0"><span class="dot" style="background:@Format.CategoryColor(b.Budget.Category)"></span><span class="fw-semibold">@b.Budget.Category</span></span>
                                <span class="small @Html.Raw(b.IsOver ? "text-neg fw-semibold" : "text-muted")">
                                    @Format.Money(b.Spent, cur) of @Format.Money(b.Budget.Limit, cur)
                                </span>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill @(b.IsOver ? "over" : b.IsNear ? "warn" : "")" style="width:@Format.Pct(Math.Min(b.PercentUsed, 100))%"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <span class="small text-muted">@Format.Pct(b.PercentUsed)% used</span>
                                @if (b.IsOver)
                                {
                                    <span class="chip chip-danger">Over by @Format.Money(Math.Abs(b.Remaining), cur)</span>
                                }
                                else
                                {
                                    <span class="small text-muted">@Format.Money(b.Remaining, cur) left</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* ------------------------------------------------ recent transactions *@
    <div class="col-12">
        <div class="card-fin">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Recent Activity</h2>
                    <div class="card-sub">latest income and expenses</div>
                </div>
            </div>
            <div class="table-responsive">
                @if (Model.Recent.Count == 0)
                {
                    <div class="empty-state">
                        <svg class="ico ico-lg text-muted"><use href="#i-wallet"/></svg>
                        <p>Nothing here yet — add your first income or expense.</p>
                    </div>
                }
                else
                {
                    <table class="fin-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Recent)
                            {
                                <tr>
                                    <td class="text-nowrap text-muted">@Format.Date(t.Date)</td>
                                    <td class="fw-semibold">@t.Title</td>
                                    <td><span class="chip"><span class="dot" style="background:@Format.CategoryColor(t.Category)"></span>@t.Category</span></td>
                                    <td class="text-end amount @(t.IsIncome ? "pos" : "neg")">
                                        @(t.IsIncome ? "+" : "-")@Format.Money(t.Amount, cur)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
