@model SettingsViewModel
@{
    // Named "changePassword" on purpose: the fields post as "changePassword.*", which
    // SettingsController.ChangePassword binds with [Bind(Prefix = PasswordFormPrefix)].
    var changePassword = new ChangePasswordViewModel();
    var initials = string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    var hasPhoto = !string.IsNullOrEmpty(Model.ProfileImage);
}

<div class="set-layout">
    @* ---------------------------------------------------------------- section nav *@
    @* Tabs: one section is shown at a time (site.js). The hash (#profile, #preferences,
       #change-password) selects the tab, so links like /Settings#change-password open it directly.
       Without JavaScript every section stays visible. *@
    <nav class="set-nav" role="tablist" aria-label="Settings sections" aria-orientation="vertical" data-tabs>
        <a href="#profile" id="tab-profile" role="tab" aria-controls="profile" aria-selected="true" class="active"><svg class="ico-sm"><use href="#i-user"/></svg>Profile</a>
        <a href="#preferences" id="tab-preferences" role="tab" aria-controls="preferences" aria-selected="false" tabindex="-1"><svg class="ico-sm"><use href="#i-globe"/></svg>Preferences</a>
        <a href="#change-password" id="tab-change-password" role="tab" aria-controls="change-password" aria-selected="false" tabindex="-1"><svg class="ico-sm"><use href="#i-lock"/></svg>Security</a>
    </nav>

    <div class="set-sections">
        @* ============================================================ Profile *@
        <section class="set-card" id="profile" role="tabpanel" aria-labelledby="tab-profile" tabindex="0">
            <header class="set-head">
                <h2>Profile</h2>
                <p>Your name, contact details and photo.</p>
            </header>

            <div class="set-body">
                <div class="set-photo">
                    <label class="form-label">Profile Picture</label>
                    <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" id="photoForm" class="m-0">
                        <label for="photoInput" class="dropzone" data-dropzone>
                            <svg class="ico dropzone-ico"><use href="#i-upload-cloud"/></svg>
                            <div class="dropzone-text">Drag &amp; drop a file here, or click to browse</div>
                            <div class="dropzone-hint">JPG, PNG, GIF or WebP — max 2MB.</div>
                            <input type="file" id="photoInput" name="photo" accept="image/png,image/jpeg,image/gif,image/webp" class="d-none"
                                   onchange="this.form.submit()" />
                        </label>
                    </form>
                    @if (hasPhoto)
                    {
                        <div class="photo-thumb">
                            <img src="@Model.ProfileImage" alt="Profile picture" />
                            <form asp-action="RemovePhoto" method="post" class="m-0">
                                <button type="submit" class="photo-thumb-remove" aria-label="Remove photo">
                                    <svg class="ico-sm"><use href="#i-trash"/></svg>
                                </button>
                            </form>
                        </div>
                    }
                </div>

                <form asp-action="UpdateProfile" method="post" novalidate id="profileForm" class="auth-form set-form">
                    <div asp-validation-summary="ModelOnly" class="banner banner-error"></div>
                    <div class="set-grid">
                        <div class="field">
                            <label asp-for="FullName" class="form-label"></label>
                            <div class="field-control">
                                <svg class="field-icon" aria-hidden="true"><use href="#i-user"/></svg>
                                <input asp-for="FullName" class="form-control" autocomplete="name" />
                            </div>
                            <span asp-validation-for="FullName" class="field-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Email" class="form-label">Email address</label>
                            <div class="field-control">
                                <svg class="field-icon" aria-hidden="true"><use href="#i-mail"/></svg>
                                <input asp-for="Email" class="form-control" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Phone" class="form-label">Phone number <span class="label-optional">Optional</span></label>
                            <div class="phone-control">
                                <select asp-for="PhoneCountry" class="phone-country" aria-label="Country code" autocomplete="tel-country-code">
                                    @foreach (var (iso, name, dial, flag) in Catalog.PhoneCountries)
                                    {
                                        <option value="@iso" data-flag="@flag" data-dial="@dial" data-name="@name" selected="@(iso == Model.PhoneCountry)">@flag @name (@dial)</option>
                                    }
                                </select>
                                <input asp-for="Phone" class="form-control" placeholder="Mobile number" autocomplete="tel-national" inputmode="tel" />
                            </div>
                            <span asp-validation-for="Phone" class="field-error"></span>
                        </div>
                    </div>
                </form>
            </div>

            <footer class="set-foot">
                <span class="set-foot-note"><svg class="ico-sm"><use href="#i-calendar"/></svg>Member since @Format.Date(Model.MemberSince)</span>
                <button type="submit" form="profileForm" name="returnTab" value="profile" class="btn btn-fin">Save changes</button>
            </footer>
        </section>

        @* ============================================================ Preferences *@
        <section class="set-card" id="preferences" role="tabpanel" aria-labelledby="tab-preferences" tabindex="0">
            <header class="set-head">
                <h2>Preferences</h2>
                <p>How amounts are shown across the app.</p>
            </header>
            <div class="set-body auth-form">
                <div class="field set-narrow mb-0">
                    <label asp-for="Currency" class="form-label"></label>
                    <div class="field-control">
                        <svg class="field-icon" aria-hidden="true"><use href="#i-dollar"/></svg>
                        @* Sits in its own card, but posts with the profile form via the form attribute. *@
                        <select asp-for="Currency" class="form-select" form="profileForm">
                            @foreach (var (code, name) in Catalog.Currencies)
                            {
                                <option value="@code" selected="@(code == Model.Currency)">@name</option>
                            }
                        </select>
                    </div>
                    <span class="field-help">Changes the currency symbol on every page. Existing amounts are not converted.</span>
                </div>
            </div>
            <footer class="set-foot">
                <span></span>
                <button type="submit" form="profileForm" name="returnTab" value="preferences" class="btn btn-fin">Save preferences</button>
            </footer>
        </section>

        @* ============================================================ Security *@
        <section class="set-card" id="change-password" role="tabpanel" aria-labelledby="tab-change-password" tabindex="0">
            <header class="set-head">
                <h2>Change password</h2>
                <p>Enter your current password, then choose a new one.</p>
            </header>
            <div class="set-body">
                <form asp-action="ChangePassword" method="post" novalidate id="passwordForm" class="auth-form set-narrow">
                    <div class="field">
                        <label asp-for="@changePassword.CurrentPassword" class="form-label"></label>
                        <div class="field-control">
                            <svg class="field-icon" aria-hidden="true"><use href="#i-lock"/></svg>
                            <input asp-for="@changePassword.CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Current password" />
                        </div>
                        <span asp-validation-for="@changePassword.CurrentPassword" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="@changePassword.NewPassword" class="form-label"></label>
                        <div class="field-control">
                            <svg class="field-icon" aria-hidden="true"><use href="#i-lock"/></svg>
                            <input asp-for="@changePassword.NewPassword" class="form-control" autocomplete="new-password" placeholder="At least 6 characters" data-strength-meter="pw-strength-settings" />
                        </div>
                        <div class="pw-strength" id="pw-strength-settings" aria-live="polite">
                            <div class="pw-bars"><span></span><span></span><span></span><span></span></div>
                            <span class="pw-label">Use a mix of letters, numbers &amp; symbols.</span>
                        </div>
                        <span asp-validation-for="@changePassword.NewPassword" class="field-error"></span>
                    </div>
                    <div class="field mb-0">
                        <label asp-for="@changePassword.ConfirmPassword" class="form-label"></label>
                        <div class="field-control">
                            <svg class="field-icon" aria-hidden="true"><use href="#i-lock-check"/></svg>
                            <input asp-for="@changePassword.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat new password" />
                        </div>
                        <span asp-validation-for="@changePassword.ConfirmPassword" class="field-error"></span>
                    </div>
                </form>
            </div>
            <footer class="set-foot">
                <span class="set-foot-note"><svg class="ico-sm"><use href="#i-shield"/></svg>You'll stay signed in on this device.</span>
                <button type="submit" form="passwordForm" class="btn btn-fin">Update password</button>
            </footer>
        </section>
    </div>
</div>
