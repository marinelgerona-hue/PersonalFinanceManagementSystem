<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Finance Management</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewBag.User == null ? "auth-body" : "")">

@* ---------------------------------------------------------------- SVG icon sprite *@
<svg xmlns="http://www.w3.org/2000/svg" style="display:none">
    <symbol id="i-dashboard" viewBox="0 0 24 24"><path d="M3 3h8v8H3zM13 3h8v5h-8zM13 10h8v11h-8zM3 13h8v8H3z"/></symbol>
    <symbol id="i-income" viewBox="0 0 24 24"><path d="M12 3v10m0 0-4-4m4 4 4-4M4 21h16"/></symbol>
    <symbol id="i-expense" viewBox="0 0 24 24"><path d="M12 21V11m0 0-4 4m4-4 4 4M4 3h16"/></symbol>
    <symbol id="i-budget" viewBox="0 0 24 24"><path d="M21.2 15.9A9 9 0 1 1 12 3v9z"/><path d="M21.2 15.9 12 12V3a9 9 0 0 1 9.2 12.9z"/></symbol>
    <symbol id="i-goal" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></symbol>
    <symbol id="i-report" viewBox="0 0 24 24"><path d="M5 20V10M12 20V4M19 20v-6"/><path d="M2 20h20"/></symbol>
    <symbol id="i-settings" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.2"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3M4.9 4.9l2.2 2.2m10-2.2-2.2 2.2M4.9 19.1l2.2-2.2m10 2.2-2.2-2.2"/></symbol>
    <symbol id="i-wallet" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M16 12h4"/><path d="M15.5 12h.5"/></symbol>
    <symbol id="i-piggy" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M15 9.6c0-1.4-1.3-2.1-3-2.1s-3 .7-3 2.1 1.4 1.8 3 2.1 3 .8 3 2.1-1.3 2.1-3 2.1-3-.7-3-2.1"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-edit" viewBox="0 0 24 24"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></symbol>
    <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/></symbol>
    <symbol id="i-up" viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></symbol>
    <symbol id="i-down" viewBox="0 0 24 24"><path d="M7 7l10 10M17 9v8H9"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></symbol>
    <symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></symbol>
    <symbol id="i-download" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5M12 15V3"/></symbol>
</svg>

@if (ViewBag.User is User currentUser)
{
    @* ============================================================ APP SHELL *@
    var nav = (ViewData["ActiveNav"] as string) ?? "";
    var initials = string.Join("", currentUser.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    <div class="app-shell">
        <aside class="app-sidebar d-none d-lg-flex">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-logo"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M16 12h4"/></svg></span>
                <span>Finance <span class="text-brand">Management</span></span>
            </a>

            <nav class="side-nav">
                <span class="side-label">Menu</span>
                <a class="side-link @(nav == "dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><svg class="ico"><use href="#i-dashboard"/></svg> Dashboard</a>
                <a class="side-link @(nav == "income" ? "active" : "")" asp-controller="Income" asp-action="Index"><svg class="ico"><use href="#i-income"/></svg> Income</a>
                <a class="side-link @(nav == "expenses" ? "active" : "")" asp-controller="Expenses" asp-action="Index"><svg class="ico"><use href="#i-expense"/></svg> Expenses</a>
                <a class="side-link @(nav == "budgets" ? "active" : "")" asp-controller="Budgets" asp-action="Index"><svg class="ico"><use href="#i-budget"/></svg> Budgets</a>
                <a class="side-link @(nav == "goals" ? "active" : "")" asp-controller="Goals" asp-action="Index"><svg class="ico"><use href="#i-goal"/></svg> Savings Goals</a>
                <a class="side-link @(nav == "reports" ? "active" : "")" asp-controller="Reports" asp-action="Index"><svg class="ico"><use href="#i-report"/></svg> Reports</a>
                <span class="side-label">Account</span>
                <a class="side-link @(nav == "settings" ? "active" : "")" asp-controller="Settings" asp-action="Index"><svg class="ico"><use href="#i-settings"/></svg> Settings</a>
            </nav>

            <div class="sidebar-footer">
                <div class="user-chip">
                    <span class="avatar">
                        @if (!string.IsNullOrEmpty(currentUser.ProfileImage))
                        {
                            <img src="@currentUser.ProfileImage" alt="" class="avatar-img" />
                        }
                        else
                        {
                            @initials
                        }
                    </span>
                    <span class="user-chip-text">
                        <span class="user-chip-name">@currentUser.FullName</span>
                        <span class="user-chip-mail">@currentUser.Email</span>
                    </span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-logout w-100"><svg class="ico"><use href="#i-logout"/></svg> Log out</button>
                </form>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                    @if (ViewData["Subtitle"] is string sub && sub.Length > 0)
                    {
                        <div class="page-sub">@sub</div>
                    }
                </div>
                <div class="topbar-user d-none d-md-flex">
                    <span class="avatar avatar-sm">
                        @if (!string.IsNullOrEmpty(currentUser.ProfileImage))
                        {
                            <img src="@currentUser.ProfileImage" alt="" class="avatar-img" />
                        }
                        else
                        {
                            @initials
                        }
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-soft btn-sm" title="Log out"><svg class="ico-sm"><use href="#i-logout"/></svg></button>
                    </form>
                </div>
            </header>

            <nav class="mobile-nav d-lg-none">
                <a class="@(nav == "dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a class="@(nav == "income" ? "active" : "")" asp-controller="Income" asp-action="Index">Income</a>
                <a class="@(nav == "expenses" ? "active" : "")" asp-controller="Expenses" asp-action="Index">Expenses</a>
                <a class="@(nav == "budgets" ? "active" : "")" asp-controller="Budgets" asp-action="Index">Budgets</a>
                <a class="@(nav == "goals" ? "active" : "")" asp-controller="Goals" asp-action="Index">Goals</a>
                <a class="@(nav == "reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">Reports</a>
                <a class="@(nav == "settings" ? "active" : "")" asp-controller="Settings" asp-action="Index">Settings</a>
            </nav>

            <main class="app-content">
                @if (TempData["Success"] is string ok)
                {
                    <div class="banner banner-success">@ok</div>
                }
                @if (TempData["Error"] is string err)
                {
                    <div class="banner banner-error">@err</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @* ============================================================ AUTH SHELL *@
    <main class="auth-main w-100">
        @RenderBody()
    </main>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
