@if (ViewBag.User is User currentUser)
{
    @* ============================================================ APP SHELL *@
    var initials = string.Join("", currentUser.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    var navState = ViewBag.Nav as NavState ?? new NavState();
    var activeNav = (ViewData["ActiveNav"] as string) ?? "";
    var alertCount = navState.Alerts.Count;
    var avatarInner = string.IsNullOrEmpty(currentUser.ProfileImage)
        ? Html.Raw(System.Net.WebUtility.HtmlEncode(initials))
        : Html.Raw($"<img src=\"{System.Net.WebUtility.HtmlEncode(currentUser.ProfileImage)}\" alt=\"\" class=\"avatar-img\" />");
    var logo = Html.Raw("<span class=\"brand-logo\"><svg class=\"ico logo-ico\"><use href=\"#i-wallet\"/></svg></span>");
    var isMac = (Context.Request.Headers.UserAgent.ToString()).Contains("Mac");
    var shortcut = isMac ? "⌘K" : "Ctrl K";

    <div class="app-shell">
        @* -------------------------------------------------------- desktop sidebar *@
        <aside class="sidebar d-none d-lg-flex" aria-label="Sidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index" title="Finance Management">
                @logo
                <span class="brand-text">Finance <span class="text-brand">Management</span></span>
            </a>

            <button type="button" class="search-trigger" data-command-open data-tip="Search">
                <svg class="ico-sm"><use href="#i-search"/></svg>
                <span class="nav-text">Search or jump to…</span>
                <kbd class="nav-text">@shortcut</kbd>
            </button>

            <partial name="_SideNav" />

            <div class="sidebar-bottom">
                @if (navState.MonthBudgeted > 0)
                {
                    var pct = navState.BudgetUsedPercent;
                    var level = pct >= 100 ? "over" : pct >= 80 ? "warn" : "";
                    <a class="budget-meter" asp-controller="Budgets" asp-action="Index" data-tip="@Format.Pct(pct)% of @navState.MonthLabel budget used">
                        <span class="budget-meter-head">
                            <span>@navState.MonthLabel budget</span>
                            <span class="budget-meter-pct @level">@Format.Pct(pct)%</span>
                        </span>
                        <span class="budget-meter-bar"><span class="@level" style="width:@Format.Pct(Math.Min(pct, 100))%"></span></span>
                        <span class="budget-meter-foot">@Format.Money0(navState.MonthSpent, navState.Currency) of @Format.Money0(navState.MonthBudgeted, navState.Currency) spent</span>
                    </a>
                }
            </div>
        </aside>

        @* -------------------------------------------------------- mobile drawer *@
        <div class="offcanvas offcanvas-start mobile-drawer d-lg-none" tabindex="-1" id="mobileNav" aria-label="Menu">
            <div class="drawer-head">
                <a class="brand" asp-controller="Dashboard" asp-action="Index">
                    @logo
                    <span class="brand-text">Finance <span class="text-brand">Management</span></span>
                </a>
                <button type="button" class="icon-btn" data-bs-dismiss="offcanvas" aria-label="Close menu"><svg class="ico-sm"><use href="#i-x"/></svg></button>
            </div>
            <partial name="_SideNav" />
        </div>

        <div class="app-main">
            @* ---------------------------------------------------- top bar *@
            <header class="app-topbar">
                <div class="topbar-left">
                    <button type="button" class="icon-btn d-none d-lg-grid" data-sidebar-toggle aria-label="Toggle sidebar" title="Toggle sidebar">
                        <svg class="ico-sm"><use href="#i-panel"/></svg>
                    </button>
                    <button type="button" class="icon-btn d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-label="Open menu">
                        <svg class="ico-sm"><use href="#i-menu"/></svg>
                    </button>
                    <span class="topbar-divider" aria-hidden="true"></span>
                    <nav aria-label="Breadcrumb" class="crumbs">
                        <a asp-controller="Dashboard" asp-action="Index" class="crumb-home d-none d-sm-inline">Finance Management</a>
                        <svg class="ico-sm crumb-sep d-none d-sm-inline" aria-hidden="true"><use href="#i-chevron-right"/></svg>
                        <span class="crumb-current" aria-current="page">@ViewData["Title"]</span>
                    </nav>
                </div>

                <div class="topbar-actions">
                    <button type="button" class="icon-btn d-lg-none" data-command-open aria-label="Search">
                        <svg class="ico-sm"><use href="#i-search"/></svg>
                    </button>

                    <div class="dropdown">
                        <button type="button" class="icon-btn has-dot" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                                aria-label="Notifications@(alertCount > 0 ? $" ({alertCount} new)" : "")" title="Notifications">
                            <svg class="ico-sm"><use href="#i-bell"/></svg>
                            @if (alertCount > 0)
                            {
                                <span class="notif-count">@(alertCount > 9 ? "9+" : alertCount.ToString())</span>
                            }
                        </button>
                        <div class="dropdown-menu dropdown-menu-end menu-fin notif-menu">
                            <div class="notif-head">
                                <span>Notifications</span>
                                @if (alertCount > 0)
                                {
                                    <span class="chip chip-muted">@alertCount</span>
                                }
                            </div>
                            @if (alertCount == 0)
                            {
                                <div class="notif-empty">
                                    <span class="notif-empty-ico"><svg class="ico"><use href="#i-check"/></svg></span>
                                    <strong>You're all caught up</strong>
                                    <span>Budget and goal alerts will show up here.</span>
                                </div>
                            }
                            else
                            {
                                <div class="notif-list">
                                    @foreach (var a in navState.Alerts)
                                    {
                                        <a class="notif-item" asp-controller="@a.Controller" asp-action="Index">
                                            <span class="notif-ico lvl-@a.Level"><svg class="ico-sm"><use href="@(a.Level == "info" ? "#i-clock" : "#i-alert")"/></svg></span>
                                            <span class="notif-text">
                                                <span class="notif-title">@a.Title</span>
                                                <span class="notif-detail">@a.Detail</span>
                                            </span>
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>


                    <span class="topbar-divider d-none d-sm-block" aria-hidden="true"></span>

                    <div class="dropdown">
                        <button type="button" class="account-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                            <span class="avatar avatar-sm">@avatarInner</span>
                            <span class="account-text d-none d-md-flex">
                                <span class="account-name">@currentUser.FullName</span>
                                <span class="account-mail">@currentUser.Email</span>
                            </span>
                            <svg class="ico-sm account-chevron d-none d-md-block"><use href="#i-chevron-down"/></svg>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end menu-fin account-menu">
                            <li class="menu-user">
                                <span class="avatar">@avatarInner</span>
                                <span class="menu-user-text">
                                    <span class="menu-user-name">@currentUser.FullName</span>
                                    <span class="menu-user-mail">@currentUser.Email</span>
                                </span>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index" asp-fragment="profile"><span class="menu-ico"><svg class="ico-sm"><use href="#i-user"/></svg></span>Personal settings</a></li>
                            <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index" asp-fragment="change-password"><span class="menu-ico"><svg class="ico-sm"><use href="#i-lock"/></svg></span>Change password</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item text-danger"><span class="menu-ico"><svg class="ico-sm"><use href="#i-logout"/></svg></span>Log out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-content">
                @* The page title already shows in the breadcrumb above, so it isn't repeated here —
                   only a visually-hidden h1 for accessibility/SEO, plus the subtitle when a page sets one. *@
                <h1 class="visually-hidden">@ViewData["Title"]</h1>
                @if (ViewData["Subtitle"] is string sub && sub.Length > 0)
                {
                    <div class="page-header">
                        <p class="page-sub">@sub</p>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    @* -------------------------------------------------------- command menu (⌘K / Ctrl+K) *@
    <div class="modal fade command-modal" id="commandMenu" tabindex="-1" aria-label="Search and quick actions" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="command-search">
                    <svg class="ico-sm"><use href="#i-search"/></svg>
                    <input type="text" class="command-input" placeholder="Search pages and actions…" autocomplete="off" aria-label="Search" />
                    <kbd>Esc</kbd>
                </div>
                <div class="command-list" role="listbox">
                    <div class="command-group">Go to</div>
                    <a class="command-item" asp-controller="Dashboard" asp-action="Index" data-keywords="home overview"><svg class="ico-sm"><use href="#i-dashboard"/></svg>Dashboard</a>
                    <a class="command-item" asp-controller="Income" asp-action="Index" data-keywords="salary earnings"><svg class="ico-sm"><use href="#i-income"/></svg>Income</a>
                    <a class="command-item" asp-controller="Expenses" asp-action="Index" data-keywords="spending transactions"><svg class="ico-sm"><use href="#i-expense"/></svg>Expenses</a>
                    <a class="command-item" asp-controller="Budgets" asp-action="Index" data-keywords="limits"><svg class="ico-sm"><use href="#i-budget"/></svg>Budgets</a>
                    <a class="command-item" asp-controller="Goals" asp-action="Index" data-keywords="savings targets"><svg class="ico-sm"><use href="#i-goal"/></svg>Savings goals</a>
                    <a class="command-item" asp-controller="Reports" asp-action="Index" data-keywords="analytics charts export"><svg class="ico-sm"><use href="#i-report"/></svg>Reports</a>
                    <a class="command-item" asp-controller="Settings" asp-action="Index" data-keywords="profile account password currency"><svg class="ico-sm"><use href="#i-settings"/></svg>Settings</a>
                    <div class="command-group">Create</div>
                    <a class="command-item" asp-controller="Income" asp-action="Create" data-keywords="new add record"><svg class="ico-sm"><use href="#i-plus"/></svg>Add income</a>
                    <a class="command-item" asp-controller="Expenses" asp-action="Create" data-keywords="new add record spend"><svg class="ico-sm"><use href="#i-plus"/></svg>Add expense</a>
                    <a class="command-item" asp-controller="Budgets" asp-action="Create" data-keywords="new add limit"><svg class="ico-sm"><use href="#i-plus"/></svg>Create budget</a>
                    <a class="command-item" asp-controller="Goals" asp-action="Create" data-keywords="new add target savings"><svg class="ico-sm"><use href="#i-plus"/></svg>Create savings goal</a>
                    <div class="command-empty" hidden>No results found.</div>
                </div>
                <div class="command-foot"><span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span><span><kbd>↵</kbd> to open</span></div>
            </div>
        </div>
    </div>
}
else
{
    @* ============================================================ AUTH SHELL *@
    <main class="auth-main w-100">
        @RenderBody()
    </main>
}

@* -------------------------------------------------------- toast notifications (bottom-left, auto-dismiss) *@
<div class="toast-stack" id="toastStack" aria-live="polite" aria-relevant="additions">
    @if (TempData["Success"] is string ok)
    {
        <div class="toast-fin is-success" role="status" data-duration="5000">
            <span class="toast-ico"><svg class="ico-sm"><use href="#i-check"/></svg></span>
            <span class="toast-body"><span class="toast-title">@(TempData["ToastTitle"] as string ?? "Success")</span><span class="toast-msg">@ok</span></span>
            <button type="button" class="toast-close" aria-label="Dismiss notification"><svg class="ico-sm"><use href="#i-x"/></svg></button>
            <span class="toast-timer" aria-hidden="true"></span>
        </div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="toast-fin is-error" role="alert" data-duration="8000">
            <span class="toast-ico"><svg class="ico-sm"><use href="#i-alert"/></svg></span>
            <span class="toast-body"><span class="toast-title">Something went wrong</span><span class="toast-msg">@err</span></span>
            <button type="button" class="toast-close" aria-label="Dismiss notification"><svg class="ico-sm"><use href="#i-x"/></svg></button>
            <span class="toast-timer" aria-hidden="true"></span>
        </div>
    }
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
