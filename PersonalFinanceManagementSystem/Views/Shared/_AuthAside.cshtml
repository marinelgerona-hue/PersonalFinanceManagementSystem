@* Left-hand brand panel shared by the Sign in and Create account pages. *@
<aside class="auth-aside" aria-hidden="true">
    <div class="auth-aside-brand">
        <span class="brand-logo"><svg class="ico logo-ico"><use href="#i-wallet"/></svg></span>
        <span>Finance <span class="text-brand">Management</span></span>
    </div>

    <div class="auth-aside-body">
        <span class="auth-eyebrow">Personal finance, simplified</span>
        <h2 class="auth-headline">Take control of every dollar you earn.</h2>
        <p class="auth-lead">Track income and expenses, set budgets that actually stick, and watch your savings goals grow — all in one place.</p>

        <div class="auth-preview">
            <div class="preview-head">
                <div>
                    <div class="preview-label">Net balance · this month</div>
                    <div class="preview-value">$4,280.50</div>
                </div>
                <span class="preview-chip">▲ 12.4%</span>
            </div>
            <div class="preview-bars">
                <span style="height:38%"></span><span style="height:52%"></span><span style="height:44%"></span>
                <span style="height:66%"></span><span style="height:58%"></span><span style="height:74%"></span>
                <span class="is-current" style="height:88%"></span>
            </div>
            <div class="preview-row">
                <span>Groceries budget</span><span>$412 of $600</span>
            </div>
            <div class="preview-track"><span style="width:69%"></span></div>
            <div class="preview-row">
                <span>Emergency fund goal</span><span>$7,500 of $10,000</span>
            </div>
            <div class="preview-track"><span class="is-goal" style="width:75%"></span></div>
        </div>

        <ul class="auth-features">
            <li><svg><use href="#i-chart-line"/></svg>Monthly, annual &amp; custom-range reports</li>
            <li><svg><use href="#i-clock"/></svg>Budgets with live spending alerts</li>
            <li><svg><use href="#i-shield"/></svg>Private by default — your data stays yours</li>
        </ul>
    </div>

    <div class="auth-aside-foot">© @DateTime.Now.Year Finance Management</div>
</aside>
