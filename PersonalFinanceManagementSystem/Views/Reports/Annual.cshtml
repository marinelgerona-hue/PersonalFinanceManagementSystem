@model AnnualSummaryViewModel
@{
    var cur = Model.Currency;
    var now = DateTime.Now;
}

<partial name="_ReportsNav" />

<div class="d-flex align-items-center gap-2 my-3 flex-wrap">
    <form method="get" class="period-picker card-fin">
        <span class="text-muted small fw-semibold">Year</span>
        <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
            @for (var y = now.Year - 4; y <= now.Year; y++)
            {
                <option value="@y" selected="@(y == Model.Year)">@y</option>
            }
        </select>
    </form>
    <a class="btn btn-soft" asp-action="ExportAnnual" asp-route-year="@Model.Year"><svg class="ico-sm"><use href="#i-download"/></svg> Export CSV</a>
</div>

<div class="row g-3">
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <span class="stat-icon tint-green"><svg class="ico"><use href="#i-income"/></svg></span>
            <div class="stat-label">Income @Model.Year</div>
            <div class="stat-value text-pos">@Format.Money(Model.TotalIncome, cur)</div>
            <div class="stat-foot">avg/month: @Format.Money(Model.AverageMonthlyIncome, cur)</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <span class="stat-icon tint-red"><svg class="ico"><use href="#i-expense"/></svg></span>
            <div class="stat-label">Expenses @Model.Year</div>
            <div class="stat-value text-neg">@Format.Money(Model.TotalExpenses, cur)</div>
            <div class="stat-foot">avg/month: @Format.Money(Model.AverageMonthlyExpenses, cur)</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <span class="stat-icon tint-indigo"><svg class="ico"><use href="#i-wallet"/></svg></span>
            <div class="stat-label">Net for the year</div>
            <div class="stat-value @(Model.TotalNet >= 0 ? "text-pos" : "text-neg")">@Format.Money(Model.TotalNet, cur)</div>
            <div class="stat-foot">income − expenses</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <span class="stat-icon tint-sky"><svg class="ico"><use href="#i-piggy"/></svg></span>
            <div class="stat-label">Added to goals</div>
            <div class="stat-value">@Format.Money(Model.TotalSaved, cur)</div>
            <div class="stat-foot">during @Model.Year</div>
        </div>
    </div>
</div>

<div class="row g-3 mt-0">
    <div class="col-lg-7">
        <div class="card-fin">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Month-by-Month · @Model.Year</h2>
                    <div class="card-sub">income, expenses, net and savings</div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="fin-table">
                    <thead>
                        <tr><th>Month</th><th class="text-end">Income</th><th class="text-end">Expenses</th><th class="text-end">Net</th><th class="text-end">To goals</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Months)
                        {
                            <tr class="@(m.Income == 0 && m.Expenses == 0 && m.Saved == 0 ? "row-empty" : "")">
                                <td class="fw-semibold">@Format.MonthName(m.Month)</td>
                                <td class="text-end amount pos">@Format.Money(m.Income, cur)</td>
                                <td class="text-end amount neg">@Format.Money(m.Expenses, cur)</td>
                                <td class="text-end amount @(m.Net >= 0 ? "pos" : "neg")">@Format.Money(m.Net, cur)</td>
                                <td class="text-end">@Format.Money(m.Saved, cur)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td>Total</td>
                            <td class="text-end amount">@Format.Money(Model.TotalIncome, cur)</td>
                            <td class="text-end amount">@Format.Money(Model.TotalExpenses, cur)</td>
                            <td class="text-end amount">@Format.Money(Model.TotalNet, cur)</td>
                            <td class="text-end">@Format.Money(Model.TotalSaved, cur)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card-fin">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Income vs Expenses</h2>
                    <div class="card-sub">each month of @Model.Year</div>
                </div>
                <div class="chart-key">
                    <span><i class="key key-income"></i> Income</span>
                    <span><i class="key key-expense"></i> Expenses</span>
                </div>
            </div>
            <div class="card-body-fin">
                @if (Model.TrendMax <= 0)
                {
                    <div class="empty-state"><p>No data for @Model.Year yet.</p></div>
                }
                else
                {
                    <div class="bar-chart bar-chart-sm">
                        @foreach (var m in Model.Months)
                        {
                            var ih = (double)(m.Income / Model.TrendMax) * 100;
                            var eh = (double)(m.Expenses / Model.TrendMax) * 100;
                            <div class="bar-group" tabindex="0" data-tooltip="@ChartTip.Build(Format.MonthName(m.Month), ("Income", Format.Money(m.Income, cur), "#10b981"), ("Expenses", Format.Money(m.Expenses, cur), "#f43f5e"), ("Net", Format.Money(m.Net, cur), null))">
                                <div class="bar-pair">
                                    <div class="bar income" style="height:@Format.Pct((decimal)ih)%"></div>
                                    <div class="bar expense" style="height:@Format.Pct((decimal)eh)%"></div>
                                </div>
                                <span class="bar-label">@m.Label</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card-fin mt-3">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Top Categories · @Model.Year</h2>
                    <div class="card-sub">where most of your money went</div>
                </div>
            </div>
            <div class="card-body-fin">
                @if (Model.TopCategories.Count == 0)
                {
                    <div class="empty-state"><p>No expenses in @Model.Year.</p></div>
                }
                else
                {
                    @foreach (var c in Model.TopCategories)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="legend-row m-0"><span class="dot" style="background:@Format.CategoryColor(c.Category)"></span><span class="fw-semibold">@c.Category</span></span>
                            <span class="small text-muted">@Format.Money(c.Amount, cur) · @Format.Pct(c.Percent)%</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
