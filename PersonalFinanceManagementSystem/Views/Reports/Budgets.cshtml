@model BudgetReportViewModel
@{
    var cur = Model.Currency;
    var now = DateTime.Now;
}

<partial name="_ReportsNav" />

<div class="d-flex align-items-center gap-2 my-3 flex-wrap">
    <form method="get" class="period-picker card-fin">
        <span class="text-muted small fw-semibold">Period</span>
        <select name="month" class="form-select form-select-sm" onchange="this.form.submit()">
            @for (var m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == Model.Month)">@Format.MonthName(m)</option>
            }
        </select>
        <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
            @for (var y = now.Year - 4; y <= now.Year; y++)
            {
                <option value="@y" selected="@(y == Model.Year)">@y</option>
            }
        </select>
    </form>
    <a class="btn btn-soft" asp-action="ExportBudgets" asp-route-year="@Model.Year" asp-route-month="@Model.Month"><svg class="ico-sm"><use href="#i-download"/></svg> Export CSV</a>
</div>

<div class="row g-3">
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <span class="stat-icon tint-indigo"><svg class="ico"><use href="#i-budget"/></svg></span>
            <div class="stat-label">Total budgeted</div>
            <div class="stat-value">@Format.Money(Model.TotalBudget, cur)</div>
            <div class="stat-foot">@Model.Budgets.Count budget@(Model.Budgets.Count == 1 ? "" : "s")</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <span class="stat-icon tint-red"><svg class="ico"><use href="#i-expense"/></svg></span>
            <div class="stat-label">Total spent</div>
            <div class="stat-value">@Format.Money(Model.TotalSpent, cur)</div>
            <div class="stat-foot">@Format.Pct(Model.OverallPercent)% of budget</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <span class="stat-icon tint-green"><svg class="ico"><use href="#i-check"/></svg></span>
            <div class="stat-label">Total remaining</div>
            <div class="stat-value @(Model.TotalRemaining < 0 ? "text-neg" : "")">@Format.Money(Model.TotalRemaining, cur)</div>
            <div class="stat-foot">@Model.MonthLabel</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-fin stat-card">
            <span class="stat-icon @(Model.OverCount > 0 ? "tint-red" : "tint-green")"><svg class="ico"><use href="#i-alert"/></svg></span>
            <div class="stat-label">Over budget</div>
            <div class="stat-value">@Model.OverCount</div>
            <div class="stat-foot">@Model.NearCount close to limit</div>
        </div>
    </div>
</div>

<div class="card-fin mt-3">
    <div class="card-head">
        <div>
            <h2 class="card-title">Budget vs Actual · @Model.MonthLabel</h2>
            <div class="card-sub">spent is calculated live from that month's expenses</div>
        </div>
    </div>
    <div class="table-responsive">
        @if (Model.Budgets.Count == 0)
        {
            <div class="empty-state">
                <p>No budgets existed for @Model.MonthLabel.</p>
                <a class="btn btn-fin btn-sm" asp-controller="Budgets" asp-action="Create"><svg class="ico-sm"><use href="#i-plus"/></svg> Add Budget</a>
            </div>
        }
        else
        {
            <table class="fin-table">
                <thead>
                    <tr><th>Category</th><th>Period</th><th class="text-end">Budget</th><th class="text-end">Spent</th><th class="text-end">Remaining</th><th class="text-end">Used</th><th style="min-width:170px">Progress</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Budgets)
                    {
                        <tr>
                            <td><span class="chip"><span class="dot" style="background:@Format.CategoryColor(b.Budget.Category)"></span>@b.Budget.Category</span></td>
                            <td class="small text-muted">@b.Budget.Period</td>
                            <td class="text-end amount">@Format.Money(b.Budget.Limit, cur)</td>
                            <td class="text-end amount">@Format.Money(b.Spent, cur)</td>
                            <td class="text-end amount @(b.Remaining < 0 ? "neg" : "pos")">@Format.Money(b.Remaining, cur)</td>
                            <td class="text-end">
                                <span class="chip @(b.IsOver ? "chip-danger" : b.IsNear ? "chip-warn" : "chip-success")">@Format.Pct(b.PercentUsed)%</span>
                            </td>
                            <td>
                                <div class="progress-track">
                                    <div class="progress-fill @(b.IsOver ? "over" : b.IsNear ? "warn" : "")" style="width:@Format.Pct(Math.Min(b.PercentUsed, 100))%"></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
