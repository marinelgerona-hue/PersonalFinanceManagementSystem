@model ExpenseListViewModel
@{
    var cur = Model.Currency;
}

<section class="kpi-grid mb-3">
    <article class="kpi">
        <div class="kpi-head">
            <span class="kpi-icon tint-red"><svg class="ico"><use href="#i-expense"/></svg></span>
            <span class="kpi-label">Spent this month</span>
        </div>
        <div class="kpi-value">@Format.Money(Model.MonthTotal, cur)</div>
        <div class="kpi-foot">@Model.ThisMonthCount record@(Model.ThisMonthCount == 1 ? "" : "s") this month</div>
    </article>
    <article class="kpi">
        <div class="kpi-head">
            <span class="kpi-icon tint-indigo"><svg class="ico"><use href="#i-wallet"/></svg></span>
            <span class="kpi-label">All-time spending</span>
        </div>
        <div class="kpi-value">@Format.Money(Model.Total, cur)</div>
        <div class="kpi-foot">@Model.RecordCount record@(Model.RecordCount == 1 ? "" : "s") in total</div>
    </article>
    <article class="kpi">
        <div class="kpi-head">
            <span class="kpi-icon tint-green"><svg class="ico"><use href="#i-income"/></svg></span>
            <span class="kpi-label">All-time income</span>
        </div>
        <div class="kpi-value">@Format.Money(Model.TotalIncome, cur)</div>
        <div class="kpi-foot">all sources</div>
    </article>
    <article class="kpi">
        <div class="kpi-head">
            <span class="kpi-icon tint-sky"><svg class="ico"><use href="#i-piggy"/></svg></span>
            <span class="kpi-label">Remaining balance</span>
        </div>
        <div class="kpi-value @(Model.RemainingBalance < 0 ? "text-neg" : "")">@Format.Money(Model.RemainingBalance, cur)</div>
        <div class="kpi-foot">income − expenses</div>
    </article>
</section>

<div class="card-fin">
    <div class="card-head">
        <div>
            <h2 class="card-title">Expense Records</h2>
            <div class="card-sub">@Model.Page.TotalCount record@(Model.Page.TotalCount == 1 ? "" : "s")@(Model.Query.Search.Length > 0 ? $" matching “{Model.Query.Search}”" : "") · totals update automatically</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-soft" asp-action="Export"><svg class="ico-sm"><use href="#i-download"/></svg> Export Excel</a>
            <a class="btn btn-fin" asp-action="Create"><svg class="ico-sm"><use href="#i-plus"/></svg> Add Expense</a>
        </div>
    </div>

    <div class="list-toolbar">
        @{ ViewData["SearchPlaceholder"] = "Search category, budget or note…"; }
        <partial name="_ListToolbar" model="Model.Query" />
    </div>

    <div class="table-responsive">
        @if (Model.Page.TotalCount == 0 && Model.Query.Search.Length > 0)
        {
            <div class="empty-state">
                <svg class="ico ico-lg text-muted"><use href="#i-search"/></svg>
                <p>No expenses match “@Model.Query.Search”.</p>
                <a class="btn btn-soft btn-sm" href="@Context.Request.WithQuery(("q", null), ("page", null))">Clear search</a>
            </div>
        }
        else if (Model.Page.TotalCount == 0)
        {
            <div class="empty-state">
                <svg class="ico ico-lg text-muted"><use href="#i-expense"/></svg>
                <p>No expenses yet. Add your first expense record to get started.</p>
            </div>
        }
        else
        {
            <table class="fin-table fin-table-fixed">
                <thead>
                    <tr>
                        @Html.SortHeader(Model.Query, "date", "Date", "desc", "col-date")
                        @Html.SortHeader(Model.Query, "category", "Category", "asc", "col-chip")
                        @Html.SortHeader(Model.Query, "budget", "Budget", "asc", "col-budget-label")
                        @Html.SortHeader(Model.Query, "pool", "Income pool", "asc", "col-chip-sm")
                        @Html.SortHeader(Model.Query, "note", "Note")
                        @Html.SortHeader(Model.Query, "amount", "Amount", "desc", "text-end col-amount")
                        <th class="text-end col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Page.Items)
                    {
                        <tr>
                            <td class="text-nowrap text-muted">@Format.Date(item.Date)</td>
                            <td>
                                <span class="chip"><span class="dot" style="background:@Format.CategoryColor(item.Category)"></span>@item.Category</span>
                            </td>
                            <td class="text-muted note-cell">
                                @(item.BudgetId is int bid && Model.BudgetNames.TryGetValue(bid, out var name) ? name : "—")
                            </td>
                            <td>
                                @if (item.IncomePool is { } pool)
                                {
                                    <span class="chip"><span class="dot" style="background:@Format.CategoryColor(pool.ToString())"></span>@pool</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-muted note-cell">@(string.IsNullOrWhiteSpace(item.Note) ? "—" : item.Note)</td>
                            <td class="text-end amount neg">-@Format.Money(item.Amount, cur)</td>
                            <td class="text-end text-nowrap">
                                <a class="btn-icon" asp-action="Edit" asp-route-id="@item.Id" title="Edit"><svg class="ico-sm"><use href="#i-edit"/></svg></a>
                                <form class="d-inline" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this expense record?');">
                                    <button type="submit" class="btn-icon danger" title="Delete"><svg class="ico-sm"><use href="#i-trash"/></svg></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (Model.Page.TotalCount > 0)
    {
        <partial name="_Pagination" model="Model.Page.ToPager(Model.Query)" />
    }
</div>
